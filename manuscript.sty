% Report presentation is configured explicitly by main.tex.
\newlength{\manuscript@strokewidth}
\newlength{\manuscript@protocolboxpadding}
\newlength{\manuscript@protocolheadertoppadding}
\newlength{\manuscript@protocolheaderbottompadding}
\setlength{\manuscript@protocolboxpadding}{5pt}
\setlength{\manuscript@protocolheadertoppadding}{4pt}
\setlength{\manuscript@protocolheaderbottompadding}{3pt}

\newcommand{\ConfigureManuscript}[1]{%
  \setlength{\manuscript@strokewidth}{#1}%
  \newtcolorbox{statementbox}{
    colback=white,
    colframe=black,
    boxrule=\manuscript@strokewidth,
    arc=0pt,
    left=4pt,
    right=4pt,
    top=3pt,
    bottom=4pt,
    before skip=6pt,
    after skip=6pt
  }%
  \newtcolorbox{protocolbox}[1]{
    colback=white,
    colframe=black,
    colbacktitle=black!8,
    coltitle=black,
    fonttitle=\bfseries,
    title={##1},
    boxrule=\manuscript@strokewidth,
    arc=0pt,
    left=\manuscript@protocolboxpadding,
    right=\manuscript@protocolboxpadding,
    toptitle=\manuscript@protocolheadertoppadding,
    bottomtitle=\manuscript@protocolheaderbottompadding,
    top=\manuscript@protocolboxpadding,
    bottom=\manuscript@protocolboxpadding,
    % Prefer stretching or shrinking the space around stages before TeX
    % distorts the spacing around nearby section headings.
    before skip=.75\baselineskip plus .75\baselineskip minus .4\baselineskip,
    after skip=.75\baselineskip plus .75\baselineskip minus .4\baselineskip
  }%
}

\newcounter{protocolstage}[subsection]
\newif\ifprotocolstagesingle
\newenvironment{protocolstage}[2][]{%
  \refstepcounter{protocolstage}%
  \begin{protocolbox}{Stage~\theprotocolstage\ --- #2}%
  \protocolstagesinglefalse
  \if\relax\detokenize{#1}\relax
    \begin{enumerate}[%
      \IEEEsetlabelwidth{(a)}%
      \setlength{\IEEElabelindent}{0pt}%
      \setlength{\topsep}{0pt}%
      \setlength{\partopsep}{0pt}%
      \setlength{\parsep}{0pt}%
      \setlength{\itemsep}{3pt}%
    ]%
      \renewcommand{\labelenumi}{(\alph{enumi})}%
      \renewcommand{\theenumi}{\theprotocolstage(\alph{enumi})}%
      \setlength{\parskip}{0pt}%
  \else
    \protocolstagesingletrue
  \fi
}{%
  \ifprotocolstagesingle\else
    \end{enumerate}%
  \fi
  \end{protocolbox}%
  \@endpetrue
}

